{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(terraform -chdir=* destroy*)",
      "Bash(terraform apply -auto-approve*)",
      "Bash(terraform destroy*)",
      "Bash(terraform force-unlock*)",
      "Bash(terraform state mv*)",
      "Bash(terraform state push*)",
      "Bash(terraform state rm*)",
      "Bash(tofu destroy*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/.env)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(tofu apply*)",
      "Bash(tofu -chdir=* apply*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/guard-terraform.py"
            ]
          }
        ]
      }
    ]
  }
}
